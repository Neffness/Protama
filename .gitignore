# Public repository starts docs-first.
# Ignore every new file by default, then explicitly allow directories and
# Markdown/publication metadata. This prevents private source or build output
# from being published accidentally while the public structure is assembled.
*
!*/
!.gitignore
!*.md
!*.json
!LICENSE
!CITATION.cff

# Local credentials and environment files remain ignored if later unignored.
.env
.env.*
.venv/
venv/
__pycache__/
*.py[cod]

# Generated and machine-local output.
build/
dist/
coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.idea/
*.log
*.tmp
*.bak
Thumbs.db
.DS_Store

# When public source is ready, add explicit allow rules for the intended
# source directories and file types rather than removing the deny-by-default
# policy globally.
!pyproject.toml
!src/
!src/**
!src/**/*.py
!tests/
!tests/**
!tests/**/*.py
