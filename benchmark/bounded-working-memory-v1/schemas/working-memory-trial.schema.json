{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protama.dev/benchmark/bounded-working-memory-v1/working-memory-trial.schema.json",
  "title": "Bounded Working Memory Trial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "thought_id",
    "capacity",
    "policy",
    "items",
    "relations",
    "distractors"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "thought_id": {
      "type": "string",
      "minLength": 1
    },
    "capacity": {
      "type": "integer",
      "minimum": 1
    },
    "policy": {
      "type": "string",
      "enum": [
        "none",
        "fifo",
        "random",
        "relevance",
        "oracle"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "distractors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "payload",
        "relevance",
        "cycle"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        },
        "relevance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cycle": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "subject_id",
        "object_id",
        "label"
      ],
      "properties": {
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
